# Server
PORT=5000
NODE_ENV=development

# Database (SQLite for local/dev - zero setup required)
# For production, swap to PostgreSQL, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/notenest?schema=public"
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=replace-this-with-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Optional: file attachments (Priority 1.2). If any of these three are
# missing, uploads automatically fall back to local disk storage under
# backend/uploads/ - no setup required for local development.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: AI Note Assistant (Priority 2.5). Without this, the AI actions
# (summarize/grammar/improve/action items/rewrite) use a local heuristic
# fallback so the feature is fully testable with no API key.
OPENAI_API_KEY=
